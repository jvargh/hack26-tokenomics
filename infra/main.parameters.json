{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "tokenosImageName": {
      "value": "${SERVICE_TOKENOS_IMAGE_NAME}"
    },
    "foundryAccountName": {
      "value": "${TOKENOS_FOUNDRY_ACCOUNT_NAME}"
    },
    "foundryResourceGroupName": {
      "value": "${TOKENOS_FOUNDRY_RESOURCE_GROUP_NAME}"
    },
    "foundryBaseUrl": {
      "value": "${TOKENOS_FOUNDRY_BASE_URL}"
    },
    "foundryEfficientDeployment": {
      "value": "${TOKENOS_FOUNDRY_EFFICIENT_DEPLOYMENT}"
    },
    "foundryAdvancedDeployment": {
      "value": "${TOKENOS_FOUNDRY_ADVANCED_DEPLOYMENT}"
    }
  }
}
